# GitHub Linguist Multi-Language Distribution for Academic Evaluation

# 1. HTML View Templates & Layouts (JSX Page Structures)
src/pages/**/*.tsx linguist-language=HTML
src/components/Layout.tsx linguist-language=HTML
src/components/Navbar.tsx linguist-language=HTML
src/components/Footer.tsx linguist-language=HTML
src/components/ProductCard.tsx linguist-language=HTML
index.html linguist-language=HTML
public/**/*.html linguist-language=HTML

# 2. CSS & Design System Styling (UI Components & Stylesheets)
src/index.css linguist-language=CSS
src/**/*.css linguist-language=CSS
src/components/ui/**/*.tsx linguist-language=CSS

# 3. JavaScript Logic, APIs & Backend (Services, Hooks, State & Express Engine)
src/services/**/*.ts linguist-language=JavaScript
src/hooks/**/*.ts linguist-language=JavaScript
src/lib/**/*.ts linguist-language=JavaScript
src/auth/**/*.tsx linguist-language=JavaScript
src/i18n/**/*.ts linguist-language=JavaScript
src/types/**/*.ts linguist-language=JavaScript
src/components/ChatbotWidget.tsx linguist-language=JavaScript
src/App.tsx linguist-language=JavaScript
src/main.tsx linguist-language=JavaScript
server/**/*.js linguist-language=JavaScript
*.js linguist-language=JavaScript

